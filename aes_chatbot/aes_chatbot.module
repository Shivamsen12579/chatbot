<?php

/**
 * @file
 * AES Chatbot module hooks.
 */

use Drupal\block_content\BlockContentInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Url;

/**
 * Implements hook_theme().
 *
 * Register a standalone theme hook for the chatbot widget. We inject it into
 * the block_content render array via hook_block_content_view, which avoids
 * fighting Drupal's block_content template suggestion machinery.
 */
function aes_chatbot_theme($existing, $type, $theme, $path) {
  return [
    'aes_chatbot_widget' => [
      'variables' => [
        'uuid' => '',
        'bot_name' => 'Assistant',
        'welcome' => '',
        'demo_url' => '',
      ],
      'template' => 'aes-chatbot-widget',
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_view() for block_content.
 *
 * For aes_chatbot bundles, append the widget render element to the build.
 * Library + per-instance drupalSettings are attached here so they only load
 * on pages where a chatbot block is actually rendered.
 *
 * The API key field is intentionally NOT exposed — only the block UUID, bot
 * name, and welcome text reach the browser.
 */
function aes_chatbot_block_content_view(array &$build, BlockContentInterface $block_content, EntityViewDisplayInterface $display, string $view_mode) {
  if ($block_content->bundle() !== 'aes_chatbot') {
    return;
  }

  $uuid = $block_content->uuid();

  $get_string = static function (string $field) use ($block_content): string {
    return $block_content->hasField($field) && !$block_content->get($field)->isEmpty()
      ? trim((string) $block_content->get($field)->value)
      : '';
  };

  $bot_name = $get_string('field_aes_chatbot_bot_name') ?: 'Assistant';
  $welcome = $get_string('field_aes_chatbot_welcome') ?: 'Hi! How can I help you today?';
  $demo_url = $get_string('field_aes_chatbot_demo_url');

  $build['aes_chatbot_widget'] = [
    '#theme' => 'aes_chatbot_widget',
    '#uuid' => $uuid,
    '#bot_name' => $bot_name,
    '#welcome' => $welcome,
    '#demo_url' => $demo_url,
    // High weight so the widget renders after any other content the
    // block_content view builder might add (e.g. a theme/contrib module
    // injecting its own fields). The widget is positioned via CSS
    // (position: fixed bottom-right), so order within the block's render
    // array doesn't affect layout — only DOM order, for accessibility.
    '#weight' => 100,
    '#attached' => [
      'library' => ['aes_chatbot/widget'],
      // Per-instance settings keyed by UUID so multiple chatbots on the
      // same page don't collide. The endpoint URL is regenerated on
      // every render (Url::fromRoute), so a route change reflects
      // without a cache clear of the widget JS.
      'drupalSettings' => [
        'aesChatbot' => [
          $uuid => [
            'endpoint' => Url::fromRoute('aes_chatbot.message', ['block_uuid' => $uuid])->toString(),
            'botName' => $bot_name,
            'welcome' => $welcome,
          ],
        ],
      ],
    ],
    '#cache' => [
      'tags' => $block_content->getCacheTags(),
      'contexts' => ['user.permissions'],
    ],
  ];
}

/**
 * Implements hook_mail().
 *
 * Shapes the two emails sent by the Request Demo form. MailManager picks
 * these up by ($module, $key) — the form sends from
 * \Drupal\aes_chatbot\Form\RequestDemoForm::submitForm().
 */
function aes_chatbot_mail($key, &$message, $params) {
  $name = $params['name'] ?? '';
  $email = $params['email'] ?? '';
  $company = $params['company'] ?? '';

  $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed; delsp=yes';

  switch ($key) {
    case 'request_demo_confirmation':
      $message['subject'] = t('Thanks for your demo request, @name', ['@name' => $name]);
      $body = [];
      $body[] = '<p>' . t('Hi @name,', ['@name' => $name]) . '</p>';
      $body[] = '<p>' . t("Thanks for reaching out from <strong>@company</strong>. We've received your request and a team member will follow up shortly at <strong>@email</strong>.", [
        '@company' => $company,
        '@email' => $email,
      ]) . '</p>';
      $body[] = '<p>' . t('— The AES team') . '</p>';
      $message['body'] = $body;
      break;

    case 'request_demo_admin_notification':
      // Reply-To is set automatically by MailManager from the $reply
      // parameter passed in RequestDemoForm::submitForm() — do NOT set it
      // here too, Symfony Mime rejects duplicate Reply-To headers.
      $message['subject'] = t('New demo request from @name (@company)', [
        '@name' => $name,
        '@company' => $company,
      ]);
      $body = [];
      $body[] = '<p>' . t('A new demo request just came in.') . '</p>';
      $body[] = '<ul>'
        . '<li><strong>' . t('Name') . ':</strong> ' . htmlspecialchars($name, ENT_QUOTES, 'UTF-8') . '</li>'
        . '<li><strong>' . t('Company') . ':</strong> ' . htmlspecialchars($company, ENT_QUOTES, 'UTF-8') . '</li>'
        . '<li><strong>' . t('Email') . ':</strong> ' . htmlspecialchars($email, ENT_QUOTES, 'UTF-8') . '</li>'
        . '</ul>';
      $message['body'] = $body;
      break;
  }
}
